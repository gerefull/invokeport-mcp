{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gerefull/invokeport",
  "title": "InvokePort",
  "description": "Remote MCP: JSON repair, JSON Schema validation, JSON to TypeScript, CSV to JSON and JSON to CSV.",
  "version": "0.3.0",
  "websiteUrl": "https://invokeport.com/agents",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://invokeport.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <scoped tools:invoke key>. Required for execution; discovery is public.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "invokeport-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "INVOKEPORT_ORIGIN",
          "description": "Trusted InvokePort HTTPS origin.",
          "value": "https://invokeport.com",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "INVOKEPORT_API_KEY",
          "description": "Scoped tools:invoke key; needed to invoke, not for public search or schemas.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
